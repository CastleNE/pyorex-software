{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qaqc.control_chart.v1",
  "title": "QAQC Shewhart Control Chart",
  "description": "Shewhart control chart for a CRM/variable pair — mean/sigma are computed from the historical recovery series itself (RF-10.5.1), not from a passed-in certified value. 'available: false' with n_points<2 is a valid response, not an error. Supersedes the earlier draft of this contract (which assumed certified_value/sigma_levels request params and a nested control_limits object) — the response now mirrors analysis/qaqc/control_charts.py::ControlChartResult exactly.",
  "version": "v1",
  "method": "qaqc.control_chart",
  "request": {
    "type": "object",
    "required": ["dataset_id", "crm_name", "variable"],
    "properties": {
      "dataset_id": { "type": "string" },
      "crm_name": { "type": "string" },
      "variable": { "type": "string" },
      "crm_warning_pct": { "type": "number", "default": 15.0 },
      "crm_failure_pct": { "type": "number", "default": 25.0 }
    }
  },
  "response": {
    "type": "object",
    "required": ["available"],
    "properties": {
      "available": { "type": "boolean" },
      "reason": { "type": "string" },
      "n_points": { "type": "integer" },
      "points": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "index": { "type": "integer" },
            "sample_id": { "type": "string" },
            "recovery_pct": { "type": "number" },
            "status": { "type": "string", "enum": ["pass", "warning", "fail"] }
          }
        }
      },
      "mean": { "type": "number" },
      "sigma": { "type": "number" },
      "ucl_1s": { "type": "number" },
      "ucl_2s": { "type": "number" },
      "ucl_3s": { "type": "number" },
      "lcl_1s": { "type": "number" },
      "lcl_2s": { "type": "number" },
      "lcl_3s": { "type": "number" },
      "westgard_violations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "rule": { "type": "string", "enum": ["1_3s", "2_2s", "10x", "drift"] },
            "description": { "type": "string" },
            "affected_indices": { "type": "array", "items": { "type": "integer" } },
            "severity": { "type": "string", "enum": ["warning", "reject"] }
          }
        }
      }
    }
  }
}

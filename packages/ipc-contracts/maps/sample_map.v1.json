{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "maps.sample_map.v1",
  "title": "Sample map with optional IDW surface",
  "description": "Every sample of the effective dataset at its real coordinates (dataset spatial_config; never reprojected), with the value of a column or expression (Diagram Builder syntax, censored/missing values never imputed) and an optional category. Optional IDW surface of that value inside the convex hull (exploration._idw; log=true interpolates log10 values and returns the grid back-transformed). Projected or local-grid coordinates only for IDW. QAQC controls excluded unless include_qaqc. analysis/maps/sample_map.py.",
  "version": "v1",
  "method": "maps.sample_map",
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": ["dataset_id"],
    "properties": {
      "dataset_id": { "type": "string" },
      "value": { "type": ["string", "null"], "maxLength": 500, "description": "Column name or expression, e.g. Cu_ppm or [Cu ppm]/[Zn ppm]" },
      "category_column": { "type": ["string", "null"] },
      "label_column": { "type": ["string", "null"] },
      "include_qaqc": { "type": "boolean", "default": false },
      "idw": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "resolution": { "type": "integer", "minimum": 11, "maximum": 250, "default": 80 },
          "power": { "type": "number", "minimum": 0.5, "maximum": 5, "default": 2 },
          "neighbors": { "type": "integer", "minimum": 3, "maximum": 64, "default": 12 },
          "radius": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "log": { "type": "boolean", "default": false }
        }
      }
    }
  },
  "response": {
    "type": "object",
    "required": ["dataset_id", "crs", "value_label", "value_columns", "category_column", "points", "quality", "grid", "grid_metrics", "warnings", "idw", "created_at"],
    "properties": {
      "dataset_id": { "type": "string" },
      "crs": {
        "type": "object",
        "required": ["source", "epsg", "label", "geographic", "unit", "x_column", "y_column", "interpolable"],
        "properties": {
          "source": { "enum": ["projected_xy", "local_grid", "wgs84_lonlat"] },
          "epsg": { "type": ["integer", "null"] },
          "label": { "type": ["string", "null"] },
          "geographic": { "type": "boolean" },
          "unit": { "type": "string" },
          "x_column": { "type": "string" },
          "y_column": { "type": "string" },
          "interpolable": { "type": "boolean" }
        }
      },
      "value_label": { "type": ["string", "null"] },
      "value_columns": { "type": "array", "items": { "type": "string" } },
      "category_column": { "type": ["string", "null"] },
      "points": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["row_index", "sample_id", "x", "y", "value", "reason", "category"],
          "properties": {
            "row_index": { "type": "integer", "description": "Position in the effective dataset (shared selection)" },
            "sample_id": { "type": "string" },
            "x": { "type": "number" }, "y": { "type": "number" },
            "value": { "type": ["number", "null"] },
            "reason": { "type": ["string", "null"] },
            "category": { "type": ["string", "null"] }
          }
        }
      },
      "quality": {
        "type": "object",
        "required": ["total", "mapped", "no_coordinates", "no_value", "excluded_qaqc"],
        "properties": { "total": { "type": "integer" }, "mapped": { "type": "integer" }, "no_coordinates": { "type": "integer" }, "no_value": { "type": "integer" }, "excluded_qaqc": { "type": "integer" } }
      },
      "grid": {
        "type": ["object", "null"],
        "required": ["x", "y", "z", "epsg", "coordinate_unit", "log"],
        "properties": {
          "x": { "type": "array", "items": { "type": "number" } },
          "y": { "type": "array", "items": { "type": "number" } },
          "z": { "type": "array", "items": { "type": "array", "items": { "type": ["number", "null"] } } },
          "epsg": { "type": ["integer", "null"] },
          "coordinate_unit": { "type": ["string", "null"] },
          "log": { "type": "boolean" }
        }
      },
      "grid_metrics": { "type": ["object", "null"] },
      "warnings": { "type": "array", "items": { "type": "string" } },
      "idw": { "type": ["object", "null"] },
      "created_at": { "type": "string" }
    }
  }
}

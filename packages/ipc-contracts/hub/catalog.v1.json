{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hub.catalog.v1",
  "title": "hub.catalog",
  "version": "v1",
  "method": "hub.catalog",
  "request": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "response": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items"
    ],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "section",
            "title",
            "summary",
            "source",
            "url",
            "tags",
            "published_at",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "section": {
              "enum": [
                "markets",
                "discoveries",
                "peru",
                "methods"
              ]
            },
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "published_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string"
            },
            "saved_at": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

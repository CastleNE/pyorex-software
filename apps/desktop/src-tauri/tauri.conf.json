{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PyOrex",
  "version": "0.1.0",
  "identifier": "com.pyorex.app",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PyOreX",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PyOreX",
    "copyright": "© 2026 PyOreX",
    "category": "Education",
    "shortDescription": "Análisis geoquímico y espectral para geología",
    "longDescription": "PyOreX: litogeoquímica, exploración mineral, mapas y secciones, y espectrometría, con un motor de cálculo científico local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../services/analytics/dist/pyorex-engine/": "engine/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
